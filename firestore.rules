rules_version = '2';

// Reglas de seguridad de la base de datos de HULUL.
//
// Por ahora (antes de tener cuentas de usuario):
// - La web y la app solo pueden CREAR reservas y solicitudes de profesionales,
//   y solo si los datos tienen el formato correcto y la aceptación de la
//   política de privacidad.
// - Nadie puede leer, cambiar ni borrar nada desde la web o la app. Los datos
//   se revisan desde la consola de Firebase.
//
// Cuando se agreguen las cuentas (Authentication), cada cliente podrá leer sus
// propias reservas y cada profesional las suyas.

service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function num(v, min, max) {
      return v is number && v >= min && v <= max;
    }

    // Punto en el mapa, opcional. Solo se acepta dentro de Ecuador
    // (incluye Galápagos).
    function location(d) {
      return !('location' in d) || (
        d.location is map
        && d.location.keys().hasOnly(['lat', 'lng'])
        && num(d.location.lat, -5.1, 1.7)
        && num(d.location.lng, -92.1, -75.1));
    }

    // Un solo correo (sin listas ni comentarios): evita usar los avisos de HULUL para escribir a terceros.
    function email(v) {
      return v is string && v.size() <= 160
        && v.matches('^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$');
    }

    function consent(d) {
      return d.consentPrivacy == true
        && d.consentMarketing is bool
        && str(d.privacyVersion, 1, 20)
        && d.createdAt == request.time;
    }

    match /inboxes/{uid}/items/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
            'source', 'clientId', 'professionalId', 'professionalName', 'category',
            'date', 'slot', 'hours', 'address', 'location', 'notes',
            'contactName', 'contactPhone', 'contactEmail', 'paymentMethod',
            'subtotal', 'fee', 'iva', 'total', 'consentMarketing', 'demo',
            'pricingVersion', 'pricing', 'visit', 'safetyAccepted', 'photos', 'surcharge', 'surchargeKind', 'noiseAccepted',
            'taxRegime', 'visitIva',
            'status', 'consentPrivacy', 'privacyVersion', 'createdAt'])
        && (!('pricingVersion' in request.resource.data) || request.resource.data.pricingVersion == 2)
        && request.resource.data.source in ['web', 'app']
        // Web y app reservan solo con cuenta, y a nombre propio (desde V5.2: la app
        // ya exige iniciar sesión; antes se aceptaban reservas de la app sin cuenta).
        && request.auth != null
        && request.resource.data.clientId == request.auth.uid
        // Un profesional puede reservar otros servicios, pero no a sí mismo.
        && request.resource.data.professionalId != request.auth.uid
        && str(request.resource.data.professionalId, 1, 80)
        && str(request.resource.data.professionalName, 1, 120)
        && str(request.resource.data.category, 1, 40)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slot.matches('^[0-9]{2}:[0-9]{2}$')
        // Duración estimada de la visita (solo para el horario).
        && num(request.resource.data.hours, 1, 8)
        // Precio por visita (desde el 18-oct-2026) y aviso de seguridad aceptado.
        && (!('pricing' in request.resource.data) || request.resource.data.pricing == 'visita')
        && (!('visit' in request.resource.data) || num(request.resource.data.visit, 1, 1000))
        && (!('safetyAccepted' in request.resource.data) || request.resource.data.safetyAccepted == true)
        // Recargo nocturno o de feriado (el servidor lo vuelve a calcular) y aviso de ruido aceptado.
        && (!('surcharge' in request.resource.data) || num(request.resource.data.surcharge, 0, 500))
        && (!('surchargeKind' in request.resource.data) || request.resource.data.surchargeKind in ['nocturno', 'feriado'])
        && (!('noiseAccepted' in request.resource.data) || request.resource.data.noiseAccepted == true)
        // Régimen del profesional e IVA de la visita (el servidor los vuelve a calcular).
        && (!('taxRegime' in request.resource.data) || request.resource.data.taxRegime in ['general', 'rimpe_emprendedor', 'rimpe_popular'])
        && (!('visitIva' in request.resource.data) || num(request.resource.data.visitIva, 0, 2000))
        // Fotos opcionales del problema (enlaces de Storage).
        && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 4))
        && str(request.resource.data.address, 8, 300)
        && location(request.resource.data)
        && str(request.resource.data.notes, 0, 1000)
        && str(request.resource.data.contactName, 2, 120)
        && str(request.resource.data.contactPhone, 7, 20)
        && (request.resource.data.contactEmail == '' || email(request.resource.data.contactEmail))
        && request.resource.data.paymentMethod in ['tarjeta', 'transferencia', 'deuna']
        && num(request.resource.data.subtotal, 0, 10000)
        && num(request.resource.data.fee, 0, 100)
        && num(request.resource.data.iva, 0, 2000)
        && num(request.resource.data.total, 0, 12000)
        && request.resource.data.demo is bool
        && request.resource.data.status == 'pendiente'
        // No se reserva a un profesional suspendido.
        && (!exists(/databases/$(database)/documents/pros/$(request.resource.data.professionalId))
            || get(/databases/$(database)/documents/pros/$(request.resource.data.professionalId)).data.get('suspendedUntil', 0) < request.time.toMillis())
        && consent(request.resource.data);
      // Cada cliente ve sus reservas.
      // Las ve el cliente que reservó y el profesional asignado. Los cambios de
      // estado los hace el servidor (cancelarReserva, gestionarReserva).
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid || resource.data.professionalId == request.auth.uid);
      allow update, delete: if false;
    }

    // Perfil del cliente: solo su dueño.
    match /clients/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'consentMarketing', 'consentPrivacy', 'privacyVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 9, 15)
        && email(request.resource.data.email)
        && request.resource.data.consentMarketing is bool
        && request.resource.data.consentPrivacy == true
        && request.resource.data.createdAt == request.time;
      // El saldo pendiente (cargos por cancelar tarde) lo escribe solo el servidor.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'consentMarketing', 'consentPrivacy', 'privacyVersion', 'createdAt', 'updatedAt', 'balance', 'credit', 'noShows'])
        && request.resource.data.get('balance', 0) == resource.data.get('balance', 0)
        && request.resource.data.get('credit', 0) == resource.data.get('credit', 0)
        && request.resource.data.get('noShows', 0) == resource.data.get('noShows', 0)
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 9, 15)
        && email(request.resource.data.email)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'phone', 'category', 'city', 'experience',
            'consentMarketing', 'status', 'consentPrivacy', 'privacyVersion', 'createdAt'])
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 7, 20)
        && str(request.resource.data.category, 1, 40)
        && str(request.resource.data.city, 1, 40)
        && str(request.resource.data.experience, 0, 2000)
        && request.resource.data.status == 'nueva'
        && consent(request.resource.data);
      allow read, update, delete: if false;
    }

    // Perfil del profesional: solo su dueño lo lee y lo escribe, y solo
    // mientras está en borrador, observado o en revisión. Aprobar, rechazar o
    // suspender lo hace HULUL desde la consola (las reglas no lo permiten aquí).
    function providerFields(d) {
      return d.keys().hasOnly([
        'uid', 'status', 'step', 'kind', 'firstName', 'lastName', 'businessName', 'cedula', 'ruc',
        'phone', 'email', 'categories', 'services', 'rates', 'minHours', 'visitRates', 'catEvidence', 'proposals', 'catStatus', 'strikes', 'tester', 'cashDebt', 'fines', 'years', 'bio',
        'cities', 'days', 'from', 'to', 'acceptsCash', 'docs', 'offHours', 'holidays', 'surcharges',
        'taxRegime', 'eSignature', 'mandateAccepted', 'payoutBalance',
        'reviewNote', 'reviewedAt', 'reviewedBy', 'verifyAlerts',
        'consentPrivacy', 'privacyVersion', 'termsAccepted', 'submittedAt', 'createdAt', 'updatedAt']);
    }

    function providerOk(uid, d) {
      return providerFields(d)
        && d.uid == uid
        && d.status in ['borrador', 'en_revision', 'observado']
        && d.updatedAt == request.time
        // Sin límite práctico de categorías (hay 19). Cada una se valida por separado;
        // su estado (catStatus) lo escribe solo el servidor.
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 40))
        && (!('visitRates' in d) || d.visitRates is map)
        && (!('catEvidence' in d) || d.catEvidence is map)
        // Actividades que no están entre las categorías: quedan en revisión.
        && (!('proposals' in d) || (d.proposals is list && d.proposals.size() <= 10))
        && (!('bio' in d) || str(d.bio, 0, 500))
        && (!('cedula' in d) || str(d.cedula, 0, 10))
        && (!('email' in d) || d.email == '' || email(d.email))
        && (!('docs' in d) || d.docs is map)
        // Fuera de horario y feriados: horas que activa y recargos en monto fijo.
        && (!('offHours' in d) || (d.offHours is list && d.offHours.size() <= 14))
        && (!('holidays' in d) || d.holidays is bool)
        && (!('surcharges' in d) || (d.surcharges is map && d.surcharges.keys().hasOnly(['nocturno', 'feriado'])))
        // Régimen tributario (define si su visita lleva IVA) y si tiene firma electrónica.
        && (!('taxRegime' in d) || d.taxRegime in ['general', 'rimpe_emprendedor', 'rimpe_popular'])
        && (!('eSignature' in d) || d.eSignature is bool)
        && (!('mandateAccepted' in d) || d.mandateAccepted is bool);
    }

    match /providers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && providerOk(uid, request.resource.data)
        && !('catStatus' in request.resource.data) && !('reviewNote' in request.resource.data) && !('strikes' in request.resource.data) && !('tester' in request.resource.data) && !('cashDebt' in request.resource.data) && !('fines' in request.resource.data) && !('payoutBalance' in request.resource.data)
        && !('strikeLog' in request.resource.data) && !('suspendedUntil' in request.resource.data) && !('strikesResetAt' in request.resource.data) && !('ratingCheckAt' in request.resource.data)
        && request.resource.data.status == 'borrador'
        && request.resource.data.createdAt == request.time;
      // catStatus (lo pone el servidor) puede existir pero no se cambia desde aquí.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.status in ['borrador', 'en_revision', 'observado']
        && providerOk(uid, request.resource.data)
        && request.resource.data.get('catStatus', null) == resource.data.get('catStatus', null)
        // La nota de revisión la escribe solo HULUL (panel o consola).
        && request.resource.data.get('reviewNote', null) == resource.data.get('reviewNote', null)
        && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null)
        && request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null)
        && request.resource.data.get('verifyAlerts', null) == resource.data.get('verifyAlerts', null)
        && request.resource.data.get('strikes', null) == resource.data.get('strikes', null)
        && request.resource.data.get('tester', null) == resource.data.get('tester', null)
        && request.resource.data.get('cashDebt', null) == resource.data.get('cashDebt', null)
        && request.resource.data.get('fines', null) == resource.data.get('fines', null)
        && request.resource.data.get('payoutBalance', null) == resource.data.get('payoutBalance', null)
        // Faltas y suspensiones: solo el servidor.
        && request.resource.data.get('strikeLog', null) == resource.data.get('strikeLog', null)
        && request.resource.data.get('suspendedUntil', null) == resource.data.get('suspendedUntil', null)
        && request.resource.data.get('strikesResetAt', null) == resource.data.get('strikesResetAt', null)
        && request.resource.data.get('ratingCheckAt', null) == resource.data.get('ratingCheckAt', null)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Datos bancarios: aparte, solo para el dueño.
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && docId == 'banco'
          && request.resource.data.keys().hasOnly(['bank', 'type', 'number', 'holder', 'holderId', 'updatedAt'])
          && str(request.resource.data.number, 6, 20)
          && request.resource.data.type in ['ahorros', 'corriente'];
      }
    }

    // Directorio público: solo profesionales aprobados. Lo escribe la función
    // directorioProfesionales; nadie lo cambia desde la web o la app.
    match /pros/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Todo lo demás, cerrado.
    // Ubicación en vivo del profesional para una reserva: la escribe solo el
    // profesional asignado mientras la reserva está confirmada, en camino o en
    // curso; la leen él y el cliente de esa reserva.
    match /tracking/{bookingId} {
      function trackedBooking() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      allow read: if request.auth != null
        && (trackedBooking().clientId == request.auth.uid || trackedBooking().professionalId == request.auth.uid);
      allow create, update: if request.auth != null
        && trackedBooking().professionalId == request.auth.uid
        && trackedBooking().status in ['confirmada', 'en_camino', 'en_curso']
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'accuracy', 'heading', 'at'])
        && num(request.resource.data.lat, -90, 90)
        && num(request.resource.data.lng, -180, 180)
        && request.resource.data.accuracy is number
        && request.resource.data.heading is number
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // Código de llegada: solo lo lee el cliente (el profesional se lo pide para
    // empezar el trabajo). Lo escribe el servidor.
    match /bookings/{bookingId}/private/{docId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid;
      allow write: if false;
    }

    // Chat de la reserva: solo el cliente y el profesional de esa reserva leen y
    // escriben; los mensajes no se editan ni se borran (respaldo para ambos).
    match /bookings/{bookingId}/messages/{msgId} {
      function chatBooking() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      }
      function chatMember() {
        return request.auth != null
          && (chatBooking().clientId == request.auth.uid || chatBooking().professionalId == request.auth.uid);
      }
      allow read: if chatMember();
      allow create: if chatMember()
        && chatBooking().status in ['pendiente', 'confirmada', 'en_camino', 'en_curso', 'por_aprobar']
        && request.resource.data.keys().hasOnly(['from', 'uid', 'kind', 'text', 'photo', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.from == (chatBooking().clientId == request.auth.uid ? 'cliente' : 'profesional')
        && request.resource.data.kind in ['texto', 'foto', 'pedir_fotos']
        && (!('text' in request.resource.data) || str(request.resource.data.text, 1, 1000))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.matches('https://firebasestorage[.]googleapis[.]com/.*')))
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Libro de movimientos de dinero y liquidaciones semanales: los escribe solo
    // el servidor; cada profesional ve los suyos. HULUL los revisa en la consola
    // (y luego en el panel de administración).
    match /ledger/{entryId} {
      allow read: if request.auth != null && resource.data.proId == request.auth.uid;
      allow write: if false;
    }
    match /payouts/{payoutId} {
      allow read: if request.auth != null && resource.data.proId == request.auth.uid;
      allow write: if false;
    }

    // Reseñas públicas de los profesionales (las escribe el servidor al calificar).
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Reclamos: los escribe solo el servidor. El cliente y el profesional de la
    // reserva ven el expediente (motivo, versiones, plazos y decisión). Los
    // textos originales sin moderar y el registro de accesos (subcolecciones)
    // solo se leen desde el panel de HULUL, por funciones del servidor.
    match /reclamos/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.clientId == request.auth.uid || resource.data.proId == request.auth.uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
