rules_version = '2';

// Reglas de seguridad de la base de datos de HULUL.
//
// Por ahora (antes de tener cuentas de usuario):
// - La web y la app solo pueden CREAR reservas y solicitudes de profesionales,
//   y solo si los datos tienen el formato correcto y la aceptación de la
//   política de privacidad.
// - Nadie puede leer, cambiar ni borrar nada desde la web o la app. Los datos
//   se revisan desde la consola de Firebase.
//
// Cuando se agreguen las cuentas (Authentication), cada cliente podrá leer sus
// propias reservas y cada profesional las suyas.

service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function num(v, min, max) {
      return v is number && v >= min && v <= max;
    }

    // Punto en el mapa, opcional. Solo se acepta dentro de Ecuador
    // (incluye Galápagos).
    function location(d) {
      return !('location' in d) || (
        d.location is map
        && d.location.keys().hasOnly(['lat', 'lng'])
        && num(d.location.lat, -5.1, 1.7)
        && num(d.location.lng, -92.1, -75.1));
    }

    function consent(d) {
      return d.consentPrivacy == true
        && d.consentMarketing is bool
        && str(d.privacyVersion, 1, 20)
        && d.createdAt == request.time;
    }

    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly([
            'source', 'clientId', 'professionalId', 'professionalName', 'category',
            'date', 'slot', 'hours', 'address', 'location', 'notes',
            'contactName', 'contactPhone', 'contactEmail', 'paymentMethod',
            'subtotal', 'fee', 'iva', 'total', 'consentMarketing', 'demo',
            'status', 'consentPrivacy', 'privacyVersion', 'createdAt'])
        && request.resource.data.source in ['web', 'app']
        // Desde la web solo se reserva con cuenta, y a nombre propio.
        // (La app se suma cuando tenga inicio de sesión.)
        && (request.resource.data.source == 'app'
            || (request.auth != null && request.resource.data.clientId == request.auth.uid))
        && str(request.resource.data.professionalId, 1, 80)
        && str(request.resource.data.professionalName, 1, 120)
        && str(request.resource.data.category, 1, 40)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.slot.matches('^[0-9]{2}:[0-9]{2}$')
        && num(request.resource.data.hours, 1, 8)
        && str(request.resource.data.address, 8, 300)
        && location(request.resource.data)
        && str(request.resource.data.notes, 0, 1000)
        && str(request.resource.data.contactName, 2, 120)
        && str(request.resource.data.contactPhone, 7, 20)
        && str(request.resource.data.contactEmail, 0, 160)
        && request.resource.data.paymentMethod in ['tarjeta', 'transferencia', 'deuna']
        && num(request.resource.data.subtotal, 0, 10000)
        && num(request.resource.data.fee, 0, 100)
        && num(request.resource.data.iva, 0, 2000)
        && num(request.resource.data.total, 0, 12000)
        && request.resource.data.demo is bool
        && request.resource.data.status == 'pendiente'
        && consent(request.resource.data);
      // Cada cliente ve sus reservas.
      allow read: if request.auth != null && resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    // Perfil del cliente: solo su dueño.
    match /clients/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'consentMarketing', 'consentPrivacy', 'privacyVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 9, 15)
        && str(request.resource.data.email, 3, 160)
        && request.resource.data.consentMarketing is bool
        && request.resource.data.consentPrivacy == true
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'consentMarketing', 'consentPrivacy', 'privacyVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.createdAt == resource.data.createdAt
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 9, 15)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly([
            'name', 'phone', 'category', 'city', 'experience',
            'consentMarketing', 'status', 'consentPrivacy', 'privacyVersion', 'createdAt'])
        && str(request.resource.data.name, 2, 120)
        && str(request.resource.data.phone, 7, 20)
        && str(request.resource.data.category, 1, 40)
        && str(request.resource.data.city, 1, 40)
        && str(request.resource.data.experience, 0, 2000)
        && request.resource.data.status == 'nueva'
        && consent(request.resource.data);
      allow read, update, delete: if false;
    }

    // Perfil del profesional: solo su dueño lo lee y lo escribe, y solo
    // mientras está en borrador, observado o en revisión. Aprobar, rechazar o
    // suspender lo hace HULUL desde la consola (las reglas no lo permiten aquí).
    function providerFields(d) {
      return d.keys().hasOnly([
        'uid', 'status', 'step', 'kind', 'firstName', 'lastName', 'businessName', 'cedula', 'ruc',
        'phone', 'email', 'categories', 'services', 'rates', 'minHours', 'years', 'bio',
        'cities', 'days', 'from', 'to', 'acceptsCash', 'docs',
        'consentPrivacy', 'privacyVersion', 'termsAccepted', 'submittedAt', 'createdAt', 'updatedAt']);
    }

    function providerOk(uid, d) {
      return providerFields(d)
        && d.uid == uid
        && d.status in ['borrador', 'en_revision', 'observado']
        && d.updatedAt == request.time
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 3))
        && (!('bio' in d) || str(d.bio, 0, 500))
        && (!('cedula' in d) || str(d.cedula, 0, 10))
        && (!('docs' in d) || d.docs is map);
    }

    match /providers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && providerOk(uid, request.resource.data)
        && request.resource.data.status == 'borrador'
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.status in ['borrador', 'en_revision', 'observado']
        && providerOk(uid, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Datos bancarios: aparte, solo para el dueño.
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && request.auth.uid == uid && docId == 'banco'
          && request.resource.data.keys().hasOnly(['bank', 'type', 'number', 'holder', 'holderId', 'updatedAt'])
          && str(request.resource.data.number, 6, 20)
          && request.resource.data.type in ['ahorros', 'corriente'];
      }
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
