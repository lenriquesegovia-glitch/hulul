{
  "expo": {
    "name": "HULUL",
    "slug": "hulul",
    "scheme": "hulul",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hulul.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HULUL usa tu ubicación para marcar dónde es el servicio y que el profesional llegue directo."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hulul.app",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBeszqtnTJ7H_PCBgKcTmWpiN8wL0ASln8"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HULUL usa tu ubicación para marcar dónde es el servicio y que el profesional llegue directo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "lsegovia941"
  }
}
