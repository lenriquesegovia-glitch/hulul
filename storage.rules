rules_version = '2';

// Archivos de HULUL en Firebase Storage.
// Documentos de profesionales: solo el propio profesional los sube y los ve.
// HULUL los revisa desde la consola de Firebase. Todo lo demás, cerrado.
service firebase.storage {
  match /b/{bucket}/o {
    match /providers/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if false;
    }
    // Fotos del diagnóstico: las sube el profesional al terminar una visita.
    // El cliente las ve por el enlace que queda guardado en su reserva.
    match /diagnosticos/{uid}/{bookingId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    // Fotos del problema que adjunta el cliente al reservar. El profesional las
    // ve por el enlace que queda guardado en la reserva.
    match /solicitudes/{uid}/{draftId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    // Fotos del chat de una reserva (las ven las dos partes por el enlace del mensaje).
    match /chat/{bookingId}/{uid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
